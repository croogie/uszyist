{
  "name": "uszyist",
  "version": "1.0.3",
  "description": "Read-only Todoist daily workflow CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croogie/uszyist.git"
  },
  "homepage": "https://github.com/croogie/uszyist#readme",
  "bugs": {
    "url": "https://github.com/croogie/uszyist/issues"
  },
  "keywords": [
    "todoist",
    "cli",
    "tasks",
    "planning"
  ],
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "uszyist": "bin/run.js"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "tsx --test test/*.test.ts",
    "start": "node bin/run.js",
    "check": "tsc --noEmit",
    "prepare": "husky"
  },
  "oclif": {
    "bin": "uszyist",
    "dirname": "uszyist",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "tasks": {
        "description": "Inspect incomplete tasks and time blocks"
      },
      "planning": {
        "description": "Assess the current daily plan"
      },
      "activity": {
        "description": "Inspect recorded Todoist events"
      }
    }
  },
  "dependencies": {
    "@doist/todoist-sdk": "15.3.1",
    "@oclif/core": "5.1.8",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.7.4",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
